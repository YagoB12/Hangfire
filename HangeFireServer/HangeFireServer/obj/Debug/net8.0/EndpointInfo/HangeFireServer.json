                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              },
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              },
              "text/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnqueueResult"
                }
              }
            }
          }
        }
      }
